# Copie para .env.local e preencha com o projeto Supabase (Dashboard > Project Settings > API).
# Ambos são públicos no app; a segurança vem do RLS.

EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ou_anon_key_aqui

# UUID do projeto EAS (necessário para Expo push token). Dashboard Expo / `eas init`.
EXPO_PUBLIC_EAS_PROJECT_ID=
